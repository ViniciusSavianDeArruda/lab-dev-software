<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.demo.Controller.PessoaController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <!-- Linha 1: ID e Nome -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="ID:"/>
        <TextField fx:id="txtId" prefWidth="60.0" editable="false" promptText="Auto"/>

        <Label text="Nome:"/>
        <TextField fx:id="txtNome" prefWidth="300.0" promptText="Digite o nome"/>
    </HBox>

    <!-- Linha 2: Sexo e Idioma -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Sexo:"/>
        <ComboBox fx:id="cbSexo" prefWidth="80.0" promptText="M/F"/>

        <Label text="Idioma:"/>
        <ComboBox fx:id="cbIdioma" prefWidth="180.0" promptText="Selecione ou digite"/>
    </HBox>

    <!-- Linha 3: Botões CRUD -->
    <HBox spacing="10.0">
        <Button text="Novo" onAction="#onNovo" prefWidth="90.0"/>
        <Button text="Salvar" onAction="#onSalvar" prefWidth="90.0"/>
        <Button text="Excluir" onAction="#onExcluir" prefWidth="90.0"/>
    </HBox>

    <!-- Linha 4: Tabela de registros -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60.0"/>
            <TableColumn fx:id="colNome" text="Nome" prefWidth="220.0"/>
            <TableColumn fx:id="colSexo" text="Sexo" prefWidth="70.0"/>
            <TableColumn fx:id="colIdioma" text="Idioma" prefWidth="130.0"/>
        </columns>
    </TableView>

</VBox>